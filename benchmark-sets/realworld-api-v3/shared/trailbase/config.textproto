  read_access_rule: "EXISTS (SELECT 1 FROM memberships m JOIN users u ON u.external_id = m.user_id WHERE m.organization_id = _ROW_.organization_id AND lower(u.auth_subject) = lower(hex(_USER_.id)))"
  create_access_rule: "EXISTS (SELECT 1 FROM memberships m JOIN users u ON u.external_id = m.user_id WHERE m.organization_id = _REQ_.organization_id AND lower(u.auth_subject) = lower(hex(_USER_.id)))"
  update_access_rule: "EXISTS (SELECT 1 FROM memberships m JOIN users u ON u.external_id = m.user_id WHERE m.organization_id = _ROW_.organization_id AND lower(u.auth_subject) = lower(hex(_USER_.id)))"
}]
